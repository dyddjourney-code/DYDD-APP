{
  "functions": {
    "app/api/command-center/couple-report/route.ts": {
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
      "maxDuration": 60
    },
    "app/api/command-center/maps-report/route.ts": {
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/assessment-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/fruitlife360/report-worker",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/waypoints-release",
      "schedule": "0 12,13 * * 5"
    }
  ]
}
